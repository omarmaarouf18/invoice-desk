<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for an optional Microsoft Store listing (release decision R6).
     scripts/package_windows.ps1 fills the @...@ values: identity from the repo
     variables MSIX_IDENTITY_NAME / MSIX_PUBLISHER / MSIX_PUBLISHER_DISPLAY_NAME
     (Partner Center), version from pubspec.yaml. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Invoice Desk</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Bilingual (Arabic/English) desktop invoicing for freelancers.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ar" />
  </Resources>
  <Applications>
    <Application Id="InvoiceDesk" Executable="invoice_desk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Invoice Desk"
        Description="Bilingual (Arabic/English) desktop invoicing for freelancers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
