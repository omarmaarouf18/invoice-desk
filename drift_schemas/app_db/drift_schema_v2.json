  "fixed_sql": [
    {
      "name": "clients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clients\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL CHECK(LENGTH(TRIM(\"name\")) > 0), \"contact\" TEXT NOT NULL DEFAULT '', \"city\" TEXT NOT NULL DEFAULT '', \"phone\" TEXT NOT NULL DEFAULT '', \"email\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "invoices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoices\" (\"id\" TEXT NOT NULL, \"client_id\" TEXT NOT NULL REFERENCES clients (id) ON DELETE RESTRICT, \"number\" TEXT NOT NULL UNIQUE, \"year\" INTEGER NOT NULL, \"seq\" INTEGER NOT NULL CHECK(\"seq\" >= 0), \"issue_date\" TEXT NOT NULL, \"due_date\" TEXT NOT NULL, \"paid_date\" TEXT NULL, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('draft', 'sent', 'paid', 'void')), \"contract_ref\" TEXT NOT NULL DEFAULT '', \"vat_on\" INTEGER NOT NULL DEFAULT 0 CHECK (\"vat_on\" IN (0, 1)), \"vat_rate_bp\" INTEGER NOT NULL DEFAULT 1400 CHECK(\"vat_rate_bp\" BETWEEN 0 AND 10000), \"notes_en\" TEXT NOT NULL DEFAULT '', \"notes_ar\" TEXT NOT NULL DEFAULT '', \"scope_on\" INTEGER NOT NULL DEFAULT 0 CHECK (\"scope_on\" IN (0, 1)), \"scope_title\" TEXT NOT NULL DEFAULT '', \"scope_overview\" TEXT NOT NULL DEFAULT '', \"scope_done\" TEXT NOT NULL DEFAULT '', \"scope_delivered\" TEXT NOT NULL DEFAULT '', \"scope_warranty\" TEXT NOT NULL DEFAULT '', \"deleted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"year\", \"seq\")) STRICT;"
        }
      ]
    },
    {
      "name": "clients_soft_delete_guard",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER clients_soft_delete_guard BEFORE UPDATE OF deleted_at ON clients WHEN NEW.deleted_at IS NOT NULL AND EXISTS (SELECT 1 FROM invoices WHERE client_id = NEW.id AND deleted_at IS NULL) BEGIN SELECT RAISE (ABORT, 'client has live invoices');END"
        }
      ]
    },
    {
      "name": "invoices_revive_guard",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER invoices_revive_guard BEFORE UPDATE OF deleted_at ON invoices WHEN NEW.deleted_at IS NULL AND EXISTS (SELECT 1 FROM clients WHERE id = NEW.client_id AND deleted_at IS NOT NULL) BEGIN SELECT RAISE (ABORT, 'client is deleted');END"
        }
      ]
    },
    {
      "name": "invoices_insert_guard",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER invoices_insert_guard BEFORE INSERT ON invoices WHEN NEW.deleted_at IS NULL AND EXISTS (SELECT 1 FROM clients WHERE id = NEW.client_id AND deleted_at IS NOT NULL) BEGIN SELECT RAISE (ABORT, 'client is deleted');END"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"name\" TEXT NOT NULL DEFAULT '', \"role\" TEXT NOT NULL DEFAULT '', \"city\" TEXT NOT NULL DEFAULT '', \"email\" TEXT NOT NULL DEFAULT '', \"phone\" TEXT NOT NULL DEFAULT '', \"website\" TEXT NOT NULL DEFAULT '', \"invoice_prefix\" TEXT NOT NULL DEFAULT 'OM', \"default_due_days\" INTEGER NOT NULL DEFAULT 30 CHECK(\"default_due_days\" BETWEEN 0 AND 3650), \"instapay\" TEXT NOT NULL DEFAULT '', \"wallet\" TEXT NOT NULL DEFAULT '', \"bank_iban\" TEXT NOT NULL DEFAULT '', \"notes_en\" TEXT NOT NULL DEFAULT '', \"notes_ar\" TEXT NOT NULL DEFAULT '', \"backup_dir\" TEXT NULL, \"last_backup_at\" INTEGER NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "sections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sections\" (\"id\" TEXT NOT NULL, \"invoice_id\" TEXT NOT NULL REFERENCES invoices (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"title_en\" TEXT NOT NULL DEFAULT '', \"title_ar\" TEXT NOT NULL DEFAULT '', \"currency\" TEXT NOT NULL CHECK(\"currency\" IN ('EGP', 'USD', 'SAR', 'AED', 'EUR')), PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"section_id\" TEXT NOT NULL REFERENCES sections (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"service\" TEXT NOT NULL DEFAULT '', \"description\" TEXT NOT NULL DEFAULT '', \"cycle\" TEXT NOT NULL CHECK(\"cycle\" IN ('one-time', 'monthly', 'annual')), \"qty\" INTEGER NOT NULL CHECK(\"qty\" >= 0), \"unit_price_minor\" INTEGER NOT NULL CHECK(\"unit_price_minor\" >= 0), PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
