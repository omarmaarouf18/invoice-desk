    {
      "id": 2,
      "references": [
        0,
        1
      ],
      "type": "trigger",
      "data": {
        "on": 0,
        "references_in_body": [
          0,
          1
        ],
        "name": "clients_soft_delete_guard",
        "sql": "CREATE TRIGGER clients_soft_delete_guard\nBEFORE UPDATE OF deleted_at ON clients\nWHEN NEW.deleted_at IS NOT NULL AND EXISTS (\n  SELECT 1 FROM invoices WHERE client_id = NEW.id AND deleted_at IS NULL\n)\nBEGIN\n  SELECT RAISE(ABORT, 'client has live invoices');\nEND;"
      }
    },
    {
      "id": 3,
      "references": [
        1,
        0
      ],
      "type": "trigger",
      "data": {
        "on": 1,
        "references_in_body": [
          1,
          0
        ],
        "name": "invoices_revive_guard",
        "sql": "CREATE TRIGGER invoices_revive_guard\nBEFORE UPDATE OF deleted_at ON invoices\nWHEN NEW.deleted_at IS NULL AND EXISTS (\n  SELECT 1 FROM clients WHERE id = NEW.client_id AND deleted_at IS NOT NULL\n)\nBEGIN\n  SELECT RAISE(ABORT, 'client is deleted');\nEND;"
      }
    },
    {
      "id": 4,
      "references": [
        1,
        0
      ],
      "type": "trigger",
      "data": {
        "on": 1,
        "references_in_body": [
          1,
          0
        ],
        "name": "invoices_insert_guard",
        "sql": "CREATE TRIGGER invoices_insert_guard\nBEFORE INSERT ON invoices\nWHEN NEW.deleted_at IS NULL AND EXISTS (\n  SELECT 1 FROM clients WHERE id = NEW.client_id AND deleted_at IS NOT NULL\n)\nBEGIN\n  SELECT RAISE(ABORT, 'client is deleted');\nEND;"
      }
    },
