import 'tables.dart';
import 'tables_calendar.dart';

-- v4: every insert and update of a syncable row bumps its `rev` and records
-- the change in `outbox` (one row per entity row, latest revision), in the
-- same transaction as the write. A future sync engine reads only the outbox.
-- The WHEN guard stops the rev bump itself from counting as a change.
-- (DELETE + INSERT, not INSERT OR REPLACE: an outer statement's conflict
-- clause, such as drift's upsert, would override OR REPLACE in a trigger.)

CREATE TRIGGER settings_sync_insert AFTER INSERT ON settings
BEGIN
  UPDATE settings SET rev = NEW.rev + 1 WHERE id = NEW.id;
  DELETE FROM outbox WHERE entity = 'settings' AND row_id = CAST(NEW.id AS TEXT);
  INSERT INTO outbox (entity, row_id, rev, changed_at)
  VALUES ('settings', CAST(NEW.id AS TEXT), NEW.rev + 1, NEW.updated_at);
END;

CREATE TRIGGER settings_sync_update AFTER UPDATE ON settings
WHEN NEW.rev = OLD.rev
BEGIN
  UPDATE settings SET rev = OLD.rev + 1 WHERE id = NEW.id;
  DELETE FROM outbox WHERE entity = 'settings' AND row_id = CAST(NEW.id AS TEXT);
  INSERT INTO outbox (entity, row_id, rev, changed_at)
  VALUES ('settings', CAST(NEW.id AS TEXT), OLD.rev + 1, NEW.updated_at);
END;

